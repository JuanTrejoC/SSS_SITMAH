generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Rol {
  admin
  infraestructura
}

enum PrioridadOficina {
  baja
  media
  alta
}

enum PrioridadSemaforo {
  alta
}

enum EstadoReporte {
  abierto
  en_proceso
  resuelto
}

enum TipoReporte {
  oficina
  semaforo
}

model Usuario {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(50)
  email        String    @unique @db.VarChar(100)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  nombre       String    @db.VarChar(100)
  rol          Rol       @default(admin)
  createdAt    DateTime  @default(now()) @map("created_at")

  reportesOficinaAtendidos  ReporteOficina[]  @relation("AtendidoOficina")
  reportesSemaforoAtendidos ReporteSemaforo[] @relation("AtendidoSemaforo")
  historial                 HistorialReporte[]
  comentarios               Comentario[]

  @@map("usuario")
}

model Area {
  id     Int     @id @default(autoincrement())
  nombre String  @db.VarChar(100)
  activo Boolean @default(true)

  reportes ReporteOficina[]

  @@map("area")
}

model Subdireccion {
  id     Int     @id @default(autoincrement())
  nombre String  @db.VarChar(100)
  activo Boolean @default(true)

  @@map("subdireccion")
}

model Sede {
  id     Int     @id @default(autoincrement())
  nombre String  @db.VarChar(100)
  activo Boolean @default(true)

  reportes ReporteOficina[]

  @@map("sede")
}

model Categoria {
  id     Int     @id @default(autoincrement())
  nombre String  @db.VarChar(100)
  activo Boolean @default(true)

  reportes ReporteOficina[]

  @@map("categoria")
}

model Cargo {
  id     Int     @id @default(autoincrement())
  nombre String  @db.VarChar(100)
  activo Boolean @default(true)

  reportes ReporteOficina[]

  @@map("cargo")
}

model Estacion {
  id     Int     @id @default(autoincrement())
  nombre String  @db.VarChar(100)
  activo Boolean @default(true)

  reportes ReporteSemaforo[]
  cruceros EstacionCrucero[]

  @@map("estacion")
}

model Crucero {
  id     Int     @id @default(autoincrement())
  nombre String  @db.VarChar(150)
  activo Boolean @default(true)

  reportes      ReporteSemaforo[]
  estaciones    EstacionCrucero[]
  controladores ControladorSemaforo[]

  @@map("crucero")
}

model EstacionCrucero {
  estacionId Int @map("estacion_id")
  cruceroId  Int @map("crucero_id")

  estacion Estacion @relation(fields: [estacionId], references: [id])
  crucero  Crucero  @relation(fields: [cruceroId], references: [id])

  @@id([estacionId, cruceroId])
  @@map("estacion_crucero")
}

model TipoFalla {
  id     Int     @id @default(autoincrement())
  nombre String  @db.VarChar(150)
  activo Boolean @default(true)

  reportes ReporteSemaforo[]

  @@map("tipo_falla")
}

model CorreoNotificacion {
  id        Int      @id @default(autoincrement())
  nombre    String   @db.VarChar(100)
  correo    String   @db.VarChar(150)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("correo_notificacion")
}

model ReporteOficina {
  id              Int              @id @default(autoincrement())
  folio           String?          @unique @db.VarChar(30)
  solicitante     String           @db.VarChar(100)
  areaId          Int              @map("area_id")
  cargoId         Int?             @map("cargo_id")
  email           String           @db.VarChar(100)
  telefono        String?          @db.VarChar(20)
  sedeId          Int              @map("sede_id")
  equipo          String?          @db.VarChar(100)
  numeroSerie     String?          @map("numero_serie") @db.VarChar(100)
  categoriaId     Int              @map("categoria_id")
  prioridad       PrioridadOficina
  descripcion     String?          @db.Text
  estado          EstadoReporte    @default(abierto)
  atendidoPorId   Int?             @map("atendido_por")
  tecnicoAtendio  String?          @map("tecnico_atendio") @db.VarChar(150)
  firmaSatisfaccion String?        @map("firma_satisfaccion") @db.LongText
  diagnosticoSolucion String?      @map("diagnostico_solucion") @db.Text
  fechaResolucion DateTime?        @map("fecha_resolucion")
  modificado      Boolean          @default(false)
  vecesModificado Int              @default(0) @map("veces_modificado")
  modificadoAt    DateTime?        @map("modificado_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  area        Area        @relation(fields: [areaId], references: [id])
  cargo       Cargo?      @relation(fields: [cargoId], references: [id])
  sede        Sede        @relation(fields: [sedeId], references: [id])
  categoria   Categoria   @relation(fields: [categoriaId], references: [id])
  atendidoPor Usuario?    @relation("AtendidoOficina", fields: [atendidoPorId], references: [id])
  evidencias      Evidencia[]
  piezasAsignadas ReporteOficinaPieza[]
  equiposAsignados ReporteOficinaEquipo[]

  @@index([estado])
  @@index([sedeId])
  @@index([createdAt])
  @@map("reporte_oficina")
}

model ReporteSemaforo {
  id              Int               @id @default(autoincrement())
  folio           String?           @unique @db.VarChar(30)
  jefeTurno       String            @map("jefe_turno") @db.VarChar(100)
  origen          String?           @db.VarChar(50)
  estacionId      Int?              @map("estacion_id")
  cruceroId       Int               @map("crucero_id")
  tipoFallaId     Int               @map("tipo_falla_id")
  descripcion     String?           @db.Text
  horaDano        DateTime          @map("hora_dano")
  prioridad       PrioridadSemaforo @default(alta)
  estado          EstadoReporte     @default(abierto)
  atendidoPorId   Int?              @map("atendido_por")
  tecnicoAtendio  String?           @map("tecnico_atendio") @db.VarChar(150)
  firmaSatisfaccion String?         @map("firma_satisfaccion") @db.LongText
  diagnosticoSolucion String?       @map("diagnostico_solucion") @db.Text
  fechaResolucion DateTime?         @map("fecha_resolucion")
  modificado      Boolean           @default(false)
  vecesModificado Int               @default(0) @map("veces_modificado")
  modificadoAt    DateTime?         @map("modificado_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  estacion    Estacion?   @relation(fields: [estacionId], references: [id])
  crucero     Crucero     @relation(fields: [cruceroId], references: [id])
  tipoFalla   TipoFalla   @relation(fields: [tipoFallaId], references: [id])
  atendidoPor     Usuario?               @relation("AtendidoSemaforo", fields: [atendidoPorId], references: [id])
  evidencias      Evidencia[]
  piezasAsignadas ReporteSemaforoPieza[]

  @@index([estado])
  @@index([cruceroId])
  @@index([createdAt])
  @@map("reporte_semaforo")
}

model Evidencia {
  id                Int      @id @default(autoincrement())
  reporteOficinaId  Int?     @map("reporte_oficina_id")
  reporteSemaforoId Int?     @map("reporte_semaforo_id")
  filename          String   @db.VarChar(255)
  filepath          String   @db.VarChar(500)
  mimetype          String?  @db.VarChar(100)
  sizeBytes         Int?     @map("size_bytes")
  tipo              String   @default("inicial") @db.VarChar(50)
  uploadedAt        DateTime @default(now()) @map("uploaded_at")

  reporteOficina  ReporteOficina?  @relation(fields: [reporteOficinaId], references: [id], onDelete: Cascade)
  reporteSemaforo ReporteSemaforo? @relation(fields: [reporteSemaforoId], references: [id], onDelete: Cascade)

  @@map("evidencia")
}

model HistorialReporte {
  id             Int         @id @default(autoincrement())
  usuarioId      Int         @map("usuario_id")
  tipoReporte    TipoReporte @map("tipo_reporte")
  reporteId      Int         @map("reporte_id")
  estadoAnterior String?     @map("estado_anterior") @db.VarChar(30)
  estadoNuevo    String?     @map("estado_nuevo") @db.VarChar(30)
  comentario     String?     @db.Text
  fecha          DateTime    @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([reporteId, tipoReporte])
  @@map("historial_reporte")
}

model Comentario {
  id          Int         @id @default(autoincrement())
  usuarioId   Int         @map("usuario_id")
  tipoReporte TipoReporte @map("tipo_reporte")
  reporteId   Int         @map("reporte_id")
  comentario  String      @db.Text
  createdAt   DateTime    @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("comentario")
}

model EquipoTecnologico {
  id               Int      @id @default(autoincrement())
  tipo             String   @db.VarChar(50) // e.g. laptop, router, lectora_tags, herramienta_tec
  numeroInventario String?  @unique @map("numero_inventario") @db.VarChar(100)
  numeroSerie      String?  @map("numero_serie") @db.VarChar(100)
  marca            String?  @db.VarChar(100)
  modelo           String?  @db.VarChar(100)
  responsable      String?  @db.VarChar(100)
  cargoResponsable String?  @map("cargo_responsable") @db.VarChar(100)
  areaUbicacion    String?  @map("area_ubicacion") @db.VarChar(150)
  direccion        String?  @db.VarChar(150)
  procedencia      String?  @db.VarChar(50)
  estatus          String?  @default("Activo") @db.VarChar(50)
  detalles         Json?    // Stores type-specific dynamic attributes
  equipoPrincipalId Int?    @map("equipo_principal_id")
  equipoPrincipal   EquipoTecnologico? @relation("EquipoComponentes", fields: [equipoPrincipalId], references: [id])
  componentes       EquipoTecnologico[] @relation("EquipoComponentes")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  resguardos       Resguardo[]
  asignacionesNuevas ReporteOficinaEquipo[] @relation("EquipoNuevo")
  asignacionesViejas ReporteOficinaEquipo[] @relation("EquipoViejo")

  @@index([tipo])
  @@index([estatus])
  @@index([responsable])
  @@index([numeroSerie])
  @@index([createdAt])
  @@map("equipo_tecnologico")
}

model ControladorSemaforo {
  id                  Int      @id @default(autoincrement())
  modelo              String   @db.VarChar(100)
  cruceroId           Int      @map("crucero_id")
  semaforos3Luces     Int      @default(0) @map("semaforos_3_luces")
  semaforos4Luces     Int      @default(0) @map("semaforos_4_luces")
  totalLedsVerdes     Int      @default(0) @map("total_leds_verdes")
  totalLedsRojos      Int      @default(0) @map("total_leds_rojos")
  totalLedsAmarillos          Int      @default(0) @map("total_leds_amarillos")
  totalFlechasVerdes          Int      @default(0) @map("total_flechas_verdes")
  totalFlechasRojas           Int      @default(0) @map("total_flechas_rojas")
  pasoPeatonal                Boolean  @default(false) @map("paso_peatonal")
  audible                     Boolean  @default(false)
  pantallaLed                 Boolean  @default(false) @map("pantalla_led")
  tarjetaRelevadora           Boolean  @default(false) @map("tarjeta_relevadora")
  fuentePoder                 Boolean  @default(false) @map("fuente_poder")
  cpu                         Boolean  @default(false)
  switch                      Boolean  @default(false)
  fibraOptica                 Boolean  @default(false) @map("fibra_optica")
  gps                         Boolean  @default(false)
  botonera                    Boolean  @default(false)
  archivoProgramacion         String?  @map("archivo_programacion") @db.VarChar(500)

  // Inspección Exterior / Cimentación y Base
  cimientoCompleto            String?  @map("cimiento_completo") @db.VarChar(10)
  cimientoCuantosDados        String?  @map("cimiento_cuantos_dados") @db.VarChar(100)
  tapaCableado                String?  @map("tapa_cableado") @db.VarChar(10)
  tornilleriaBaseCompleta     String?  @map("tornilleria_base_completa") @db.VarChar(10)
  tornilleriaCuantosTornillos String?  @map("tornilleria_cuantos_tornillos") @db.VarChar(100)
  observacionesExterior       String?  @map("observaciones_exterior") @db.Text

  // Electrónica Interna - Módulo GPS
  gpsModelo                   String?  @map("gps_modelo") @db.VarChar(50)
  gpsComponenteFisico         String?  @map("gps_componente_fisico") @db.VarChar(50)
  gpsAntenaExterior           String?  @map("gps_antena_exterior") @db.VarChar(50)

  // Configuración de CPU, Red y Gabinete
  numeroGabinete              String?  @map("numero_gabinete") @db.VarChar(50)
  versionFirmware             String?  @map("version_firmware") @db.VarChar(50)
  ipLocal                     String?  @map("ip_local") @db.VarChar(50)
  ipSystem                    String?  @map("ip_system") @db.VarChar(50)
  mascaraRed                  String?  @map("mascara_red") @db.VarChar(50)
  gateway                     String?  @map("gateway") @db.VarChar(50)
  cicloCompleto               String?  @map("ciclo_completo") @db.VarChar(100)
  respaldoProgramacionUsb     String?  @map("respaldo_programacion_usb") @db.VarChar(100)

  // Electrónica Interna - Conflictos y Relevadores
  tarjetaConflictosMarca      String?  @map("tarjeta_conflictos_marca") @db.VarChar(100)
  tarjetaConflictosModelo     String?  @map("tarjeta_conflictos_modelo") @db.VarChar(100)
  tarjetaConflictosEstado     String?  @map("tarjeta_conflictos_estado") @db.VarChar(50)
  tarjetaRelevadoresMarca     String?  @map("tarjeta_relevadores_marca") @db.VarChar(100)
  tarjetaRelevadoresModelo    String?  @map("tarjeta_relevadores_modelo") @db.VarChar(100)
  tarjetaRelevadoresCantidad  String?  @map("tarjeta_relevadores_cantidad") @db.VarChar(50)

  // Sección C: Red, Conectividad y Energía
  switchFibraMarca            String?  @map("switch_fibra_marca") @db.VarChar(100)
  switchFibraModelo           String?  @map("switch_fibra_modelo") @db.VarChar(100)
  switchFibraPuertosTotal     String?  @map("switch_fibra_puertos_total") @db.VarChar(50)
  switchFibraPuertosUso       String?  @map("switch_fibra_puertos_uso") @db.VarChar(50)
  switchFibraFuentePoder      String?  @map("switch_fibra_fuente_poder") @db.VarChar(50)
  receptorFibraDispositivo    String?  @map("receptor_fibra_dispositivo") @db.VarChar(50)
  receptorFibraCable          String?  @map("receptor_fibra_cable") @db.VarChar(50)
  conexionesTarjetaMadre      String?  @map("conexiones_tarjeta_madre") @db.VarChar(50)
  fuentePoderSupresorPicos    String?  @map("fuente_poder_supresor_picos") @db.VarChar(50)

  // Sección D: Postes (SEMEX)
  posteModeloTipo             String?  @map("poste_modelo_tipo") @db.VarChar(100)
  posteTapaRegistro           String?  @map("poste_tapa_registro") @db.VarChar(50)
  posteObservaciones          String?  @map("poste_observaciones") @db.Text
  postesDetalle               Json?    @map("postes_detalle")

  // Cabezales Vehiculares
  tipoCabezal                 String?  @default("LED") @map("tipo_cabezal") @db.VarChar(50)
  cabezalModelo               String?  @map("cabezal_modelo") @db.VarChar(100)
  pantallaPiezas              Int?     @default(0) @map("pantalla_piezas")
  pantallaEstado              String?  @map("pantalla_estado") @db.VarChar(50)
  cabezalesDetalle            Json?    @map("cabezales_detalle")

  // Semáforos Peatonales
  peatonalModelo              String?  @map("peatonal_modelo") @db.VarChar(100)
  peatonalModuloEstado        String?  @map("peatonal_modulo_estado") @db.VarChar(50)
  peatonalObservaciones       String?  @map("peatonal_observaciones") @db.Text
  audibleModelo               String?  @map("audible_modelo") @db.VarChar(100)
  audibleModuloEstado         String?  @map("audible_modulo_estado") @db.VarChar(50)
  audibleObservaciones        String?  @map("audible_observaciones") @db.Text

  // Cámaras Videodetectoras
  camaraModelo                String?  @map("camara_modelo") @db.VarChar(100)
  camaraCantidad              String?  @map("camara_cantidad") @db.VarChar(50)
  camaraObservaciones         String?  @map("camara_observaciones") @db.Text

  // Registros de Piso
  registrosPisoTapas          String?  @map("registros_piso_tapas") @db.VarChar(50)
  registrosPisoDanados        Int?     @default(0) @map("registros_piso_danados")
  registrosPisoCoordenadas    Json?    @map("registros_piso_coordenadas")

  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  crucero             Crucero  @relation(fields: [cruceroId], references: [id])
  resguardos          Resguardo[]

  @@map("controlador_semaforo")
}

model ExistenciaComponente {
  id               Int                    @id @default(autoincrement())
  nombre           String                 @db.VarChar(150)
  categoria        String                 @db.VarChar(50) // e.g. componente, accesorio, periferico, equipo, herramienta
  cantidad         Int                    @default(0)
  estadoFisico     String?                @default("Buen Estado") @map("estado_fisico") @db.VarChar(50)
  marca            String?                @db.VarChar(100)
  modelo           String?                @db.VarChar(100)
  numeroSerie      String?                @map("numero_serie") @db.VarChar(100)
  numeroInventario String?                @map("numero_inventario") @db.VarChar(100)
  tipoInventario   String                 @default("semaforos") @map("tipo_inventario") @db.VarChar(50)
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  reportes         ReporteSemaforoPieza[]
  reportesOficina  ReporteOficinaPieza[]
  resguardos       Resguardo[]

  @@index([tipoInventario])
  @@index([categoria])
  @@index([nombre])
  @@map("existencia_componente")
}

model ReporteSemaforoPieza {
  id                          Int                  @id @default(autoincrement())
  reporteSemaforoId           Int                  @map("reporte_semaforo_id")
  componenteId                Int                  @map("componente_id")
  cantidad                    Int
  estadoPiezaReemplazada      String?              @default("reparacion") @map("estado_pieza_reemplazada") @db.VarChar(50)
  piezaReemplazadaExistenciaId Int?                 @map("pieza_reemplazada_existencia_id")
  createdAt                   DateTime             @default(now()) @map("created_at")

  reporteSemaforo   ReporteSemaforo      @relation(fields: [reporteSemaforoId], references: [id], onDelete: Cascade)
  componente        ExistenciaComponente @relation(fields: [componenteId], references: [id])

  @@map("reporte_semaforo_pieza")
}

model ReporteOficinaPieza {
  id                          Int                  @id @default(autoincrement())
  reporteOficinaId            Int                  @map("reporte_oficina_id")
  componenteId                Int                  @map("componente_id")
  cantidad                    Int
  estadoPiezaReemplazada      String?              @default("reparacion") @map("estado_pieza_reemplazada") @db.VarChar(50)
  piezaReemplazadaExistenciaId Int?                 @map("pieza_reemplazada_existencia_id")
  createdAt                   DateTime             @default(now()) @map("created_at")

  reporteOficina    ReporteOficina       @relation(fields: [reporteOficinaId], references: [id], onDelete: Cascade)
  componente        ExistenciaComponente @relation(fields: [componenteId], references: [id])

  @@map("reporte_oficina_pieza")
}

model InventarioMobiliario {
  id                 Int      @id @default(autoincrement())
  numeroInventario   String   @unique @map("numero_inventario") @db.VarChar(100)
  bien               String   @db.VarChar(100)
  marca              String?  @db.VarChar(100)
  modelo             String?  @db.VarChar(100)
  numeroSerie        String?  @map("numero_serie") @db.VarChar(100)
  descripcion        String   @db.Text
  direccion          String?  @db.VarChar(150)
  subdireccion       String?  @db.VarChar(150)
  area               String?  @db.VarChar(150)
  cargo              String?  @db.VarChar(150)
  nombreResguardante String   @map("nombre_resguardante") @db.VarChar(150)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  resguardos         Resguardo[]

  @@index([bien])
  @@index([nombreResguardante])
  @@map("inventario_mobiliario")
}

model Resguardo {
  id                   Int       @id @default(autoincrement())
  tipoInventario       String    @map("tipo_inventario") @db.VarChar(50) // 'mobiliario', 'tecnologico', 'semaforos'
  
  mobiliarioId         Int?      @map("mobiliario_id")
  equipoTecnologicoId  Int?      @map("equipo_tecnologico_id")
  existenciaId         Int?      @map("existencia_id")
  controladorSemaforoId Int?     @map("controlador_semaforo_id")

  descripcionPdf       String?   @map("descripcion_pdf") @db.Text
  numeroSeriePdf       String?   @map("numero_serie_pdf") @db.VarChar(100)

  fechaPrestamo        DateTime  @default(now()) @map("fecha_prestamo")
  fechaDevolucion      DateTime? @map("fecha_devolucion")
  
  nombreResguardante   String    @map("nombre_resguardante") @db.VarChar(150)
  cargo                String?   @db.VarChar(150)
  direccion            String?   @db.VarChar(150)
  area                 String?   @db.VarChar(150)
  estado               String    @default("Activo") @db.VarChar(50) // Activo, Devuelto
  observaciones        String?   @db.Text

  archivoFirmado       String?   @map("archivo_firmado") @db.VarChar(255)
  archivoFirmadoMime   String?   @map("archivo_firmado_mime") @db.VarChar(100)
  fechaFirmado         DateTime? @map("fecha_firmado")

  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  mobiliario           InventarioMobiliario? @relation(fields: [mobiliarioId], references: [id])
  equipoTecnologico    EquipoTecnologico?    @relation(fields: [equipoTecnologicoId], references: [id])
  existencia           ExistenciaComponente? @relation(fields: [existenciaId], references: [id])
  controladorSemaforo  ControladorSemaforo?  @relation(fields: [controladorSemaforoId], references: [id])

  @@index([tipoInventario])
  @@index([estado])
  @@index([nombreResguardante])
  @@index([createdAt])
  @@map("resguardo")
}


model ReporteOficinaEquipo {
  id                   Int               @id @default(autoincrement())
  reporteOficinaId     Int               @map("reporte_oficina_id")
  equipoNuevoId        Int               @map("equipo_nuevo_id")
  equipoViejoId        Int?              @map("equipo_viejo_id")
  tipoOperacion        String            @db.VarChar(50)
  estadoViejo          String?           @map("estado_viejo") @db.VarChar(50)
  equipoViejoPrincipalId Int?            @map("equipo_viejo_principal_id")
  createdAt            DateTime          @default(now()) @map("created_at")

  reporteOficina       ReporteOficina    @relation(fields: [reporteOficinaId], references: [id], onDelete: Cascade)
  equipoNuevo          EquipoTecnologico @relation("EquipoNuevo", fields: [equipoNuevoId], references: [id])
  equipoViejo          EquipoTecnologico? @relation("EquipoViejo", fields: [equipoViejoId], references: [id])

  @@map("reporte_oficina_equipo")
}