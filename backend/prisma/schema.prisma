generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Rol {
  admin
}

enum PrioridadOficina {
  baja
  media
  alta
}

enum PrioridadSemaforo {
  alta
}

enum EstadoReporte {
  abierto
  en_proceso
  resuelto
}

enum TipoReporte {
  oficina
  semaforo
}

model Usuario {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(50)
  email        String    @unique @db.VarChar(100)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  nombre       String    @db.VarChar(100)
  rol          Rol       @default(admin)
  createdAt    DateTime  @default(now()) @map("created_at")

  reportesOficinaAtendidos  ReporteOficina[]  @relation("AtendidoOficina")
  reportesSemaforoAtendidos ReporteSemaforo[] @relation("AtendidoSemaforo")
  historial                 HistorialReporte[]
  comentarios               Comentario[]

  @@map("usuario")
}

model Area {
  id     Int     @id @default(autoincrement())
  nombre String  @db.VarChar(100)
  activo Boolean @default(true)

  reportes ReporteOficina[]

  @@map("area")
}

model Sede {
  id     Int     @id @default(autoincrement())
  nombre String  @db.VarChar(100)
  activo Boolean @default(true)

  reportes ReporteOficina[]

  @@map("sede")
}

model Categoria {
  id     Int     @id @default(autoincrement())
  nombre String  @db.VarChar(100)
  activo Boolean @default(true)

  reportes ReporteOficina[]

  @@map("categoria")
}

model Cargo {
  id     Int     @id @default(autoincrement())
  nombre String  @db.VarChar(100)
  activo Boolean @default(true)

  reportes ReporteOficina[]

  @@map("cargo")
}

model Estacion {
  id     Int     @id @default(autoincrement())
  nombre String  @db.VarChar(100)
  activo Boolean @default(true)

  reportes ReporteSemaforo[]
  cruceros EstacionCrucero[]

  @@map("estacion")
}

model Crucero {
  id     Int     @id @default(autoincrement())
  nombre String  @db.VarChar(150)
  activo Boolean @default(true)

  reportes      ReporteSemaforo[]
  estaciones    EstacionCrucero[]
  controladores ControladorSemaforo[]

  @@map("crucero")
}

model EstacionCrucero {
  estacionId Int @map("estacion_id")
  cruceroId  Int @map("crucero_id")

  estacion Estacion @relation(fields: [estacionId], references: [id])
  crucero  Crucero  @relation(fields: [cruceroId], references: [id])

  @@id([estacionId, cruceroId])
  @@map("estacion_crucero")
}

model TipoFalla {
  id     Int     @id @default(autoincrement())
  nombre String  @db.VarChar(150)
  activo Boolean @default(true)

  reportes ReporteSemaforo[]

  @@map("tipo_falla")
}

model CorreoNotificacion {
  id        Int      @id @default(autoincrement())
  nombre    String   @db.VarChar(100)
  correo    String   @db.VarChar(150)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("correo_notificacion")
}

model ReporteOficina {
  id              Int              @id @default(autoincrement())
  folio           String?          @unique @db.VarChar(30)
  solicitante     String           @db.VarChar(100)
  areaId          Int              @map("area_id")
  cargoId         Int?             @map("cargo_id")
  email           String           @db.VarChar(100)
  telefono        String?          @db.VarChar(20)
  sedeId          Int              @map("sede_id")
  equipo          String?          @db.VarChar(100)
  categoriaId     Int              @map("categoria_id")
  prioridad       PrioridadOficina
  descripcion     String?          @db.Text
  estado          EstadoReporte    @default(abierto)
  atendidoPorId   Int?             @map("atendido_por")
  fechaResolucion DateTime?        @map("fecha_resolucion")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  area        Area        @relation(fields: [areaId], references: [id])
  cargo       Cargo?      @relation(fields: [cargoId], references: [id])
  sede        Sede        @relation(fields: [sedeId], references: [id])
  categoria   Categoria   @relation(fields: [categoriaId], references: [id])
  atendidoPor Usuario?    @relation("AtendidoOficina", fields: [atendidoPorId], references: [id])
  evidencias  Evidencia[]

  @@index([estado])
  @@index([sedeId])
  @@index([createdAt])
  @@map("reporte_oficina")
}

model ReporteSemaforo {
  id              Int               @id @default(autoincrement())
  folio           String?           @unique @db.VarChar(30)
  jefeTurno       String            @map("jefe_turno") @db.VarChar(100)
  estacionId      Int               @map("estacion_id")
  cruceroId       Int               @map("crucero_id")
  tipoFallaId     Int               @map("tipo_falla_id")
  descripcion     String?           @db.Text
  horaDano        DateTime          @map("hora_dano")
  prioridad       PrioridadSemaforo @default(alta)
  estado          EstadoReporte     @default(abierto)
  atendidoPorId   Int?              @map("atendido_por")
  fechaResolucion DateTime?         @map("fecha_resolucion")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  estacion    Estacion    @relation(fields: [estacionId], references: [id])
  crucero     Crucero     @relation(fields: [cruceroId], references: [id])
  tipoFalla   TipoFalla   @relation(fields: [tipoFallaId], references: [id])
  atendidoPor     Usuario?               @relation("AtendidoSemaforo", fields: [atendidoPorId], references: [id])
  evidencias      Evidencia[]
  piezasAsignadas ReporteSemaforoPieza[]

  @@index([estado])
  @@index([cruceroId])
  @@index([createdAt])
  @@map("reporte_semaforo")
}

model Evidencia {
  id                Int      @id @default(autoincrement())
  reporteOficinaId  Int?     @map("reporte_oficina_id")
  reporteSemaforoId Int?     @map("reporte_semaforo_id")
  filename          String   @db.VarChar(255)
  filepath          String   @db.VarChar(500)
  mimetype          String?  @db.VarChar(100)
  sizeBytes         Int?     @map("size_bytes")
  uploadedAt        DateTime @default(now()) @map("uploaded_at")

  reporteOficina  ReporteOficina?  @relation(fields: [reporteOficinaId], references: [id], onDelete: Cascade)
  reporteSemaforo ReporteSemaforo? @relation(fields: [reporteSemaforoId], references: [id], onDelete: Cascade)

  @@map("evidencia")
}

model HistorialReporte {
  id             Int         @id @default(autoincrement())
  usuarioId      Int         @map("usuario_id")
  tipoReporte    TipoReporte @map("tipo_reporte")
  reporteId      Int         @map("reporte_id")
  estadoAnterior String?     @map("estado_anterior") @db.VarChar(30)
  estadoNuevo    String?     @map("estado_nuevo") @db.VarChar(30)
  comentario     String?     @db.Text
  fecha          DateTime    @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([reporteId, tipoReporte])
  @@map("historial_reporte")
}

model Comentario {
  id          Int         @id @default(autoincrement())
  usuarioId   Int         @map("usuario_id")
  tipoReporte TipoReporte @map("tipo_reporte")
  reporteId   Int         @map("reporte_id")
  comentario  String      @db.Text
  createdAt   DateTime    @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("comentario")
}

model EquipoTecnologico {
  id               Int      @id @default(autoincrement())
  tipo             String   @db.VarChar(50) // e.g. laptop, router, lectora_tags, herramienta_tec
  numeroInventario String?  @unique @map("numero_inventario") @db.VarChar(100)
  numeroSerie      String?  @map("numero_serie") @db.VarChar(100)
  marca            String?  @db.VarChar(100)
  modelo           String?  @db.VarChar(100)
  responsable      String?  @db.VarChar(100)
  cargoResponsable String?  @map("cargo_responsable") @db.VarChar(100)
  areaUbicacion    String?  @map("area_ubicacion") @db.VarChar(150)
  detalles         Json?    // Stores type-specific dynamic attributes
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("equipo_tecnologico")
}

model ControladorSemaforo {
  id                  Int      @id @default(autoincrement())
  modelo              String   @db.VarChar(100)
  cruceroId           Int      @map("crucero_id")
  totalCabezales      Int      @default(0) @map("total_cabezales")
  totalLedsVerdes     Int      @default(0) @map("total_leds_verdes")
  totalLedsRojos      Int      @default(0) @map("total_leds_rojos")
  totalLedsAmarillos  Int      @default(0) @map("total_leds_amarillos")
  pasoPeatonal        Boolean  @default(false) @map("paso_peatonal")
  audible             Boolean  @default(false)
  pantallaLed         Boolean  @default(false) @map("pantalla_led")
  tarjetaRelevadora   Boolean  @default(false) @map("tarjeta_relevadora")
  fuentePoder         Boolean  @default(false) @map("fuente_poder")
  cpu                 Boolean  @default(false)
  switch              Boolean  @default(false)
  fibraOptica         Boolean  @default(false) @map("fibra_optica")
  gps                 Boolean  @default(false)
  botonera            Boolean  @default(false)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  crucero             Crucero  @relation(fields: [cruceroId], references: [id])

  @@map("controlador_semaforo")
}

model ExistenciaComponente {
  id        Int                    @id @default(autoincrement())
  nombre    String                 @unique @db.VarChar(150)
  categoria String                 @db.VarChar(50) // e.g. componente, accesorio, periferico, equipo, herramienta
  cantidad  Int                    @default(0)
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")
  reportes  ReporteSemaforoPieza[]

  @@map("existencia_componente")
}

model ReporteSemaforoPieza {
  id                Int                  @id @default(autoincrement())
  reporteSemaforoId Int                  @map("reporte_semaforo_id")
  componenteId      Int                  @map("componente_id")
  cantidad          Int
  createdAt         DateTime             @default(now()) @map("created_at")

  reporteSemaforo   ReporteSemaforo      @relation(fields: [reporteSemaforoId], references: [id], onDelete: Cascade)
  componente        ExistenciaComponente @relation(fields: [componenteId], references: [id])

  @@map("reporte_semaforo_pieza")
}
